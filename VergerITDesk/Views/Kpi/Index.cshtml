@model KpiIndexVm
@{ ViewData["Title"] = "KPI Library"; }
<div class="topbar">
    <div><h1>KPI Library</h1><p>Digital &amp; IT KPI Master Sheet — targets vs actuals</p></div>
</div>
<div class="view">
    <p class="hint" style="margin-bottom:16px;">Two KPIs (IT.3.5, IT.3.6) are computed live from ticket data — IT.3.5's SLA clock pauses automatically while a ticket is "Awaiting Info". The rest are tracked manually for the current fiscal month (@Model.CurrentMonth).</p>
    <table>
        <thead><tr><th>KPI</th><th>Owner</th><th>Weight</th><th>Target</th><th>Actual (@Model.CurrentMonth)</th><th></th></tr></thead>
        <tbody>
        @foreach (var ownerGroup in Model.Rows.GroupBy(r => r.Definition.Owner))
        {
            <tr style="background:var(--surface-2);"><td colspan="6" style="font-weight:700;font-size:12px;text-transform:uppercase;">@ownerGroup.Key — @ownerGroup.First().Definition.Role</td></tr>
            foreach (var row in ownerGroup)
            {
                var d = row.Definition;
                var good = row.CurrentMonthActual.HasValue && row.CurrentMonthActual.Value >= d.Target;
                <tr>
                    <td>
                        <div style="font-weight:650;">
                            @d.Ref · @d.Name
                            @if (row.IsLive) { <span class="pill good" style="margin-left:6px;">LIVE</span> }
                        </div>
                        <div class="hint">@d.Csf · @d.Formula</div>
                    </td>
                    <td><span class="owner-chip">@d.Role</span></td>
                    <td>@d.Weight%</td>
                    <td style="font-weight:650;">@d.Target.ToString("P1")</td>
                    <td>
                        @if (row.IsLive)
                        {
                            <span class="pill @(row.CurrentMonthActual.HasValue ? (good ? "good" : "bad") : "warn")">@(row.CurrentMonthActual.HasValue ? row.CurrentMonthActual.Value.ToString("P1") : "—")</span>
                        }
                        else
                        {
                            <form asp-action="SaveActual" method="post" style="display:flex;gap:6px;align-items:center;">
                                <input type="hidden" name="kpiRef" value="@d.Ref" />
                                <input type="hidden" name="month" value="@Model.CurrentMonth" />
                                <input type="number" name="percentValue" step="0.1" min="0" max="200" style="width:70px;padding:5px 7px;"
                                       value="@(row.CurrentMonthActual.HasValue ? Math.Round(row.CurrentMonthActual.Value * 100, 1) : (decimal?)null)" />
                                <button type="submit" class="btn sm">Save</button>
                            </form>
                        }
                    </td>
                    <td><a asp-action="Trend" asp-route-kpiRef="@d.Ref" class="hint" style="color:var(--green-600);text-decoration:underline;">Months</a></td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>
