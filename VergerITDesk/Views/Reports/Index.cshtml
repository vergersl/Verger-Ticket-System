@using VergerITDesk.Services
@{
    ViewData["Title"] = "Reports";
    var m = (TicketMetrics)ViewBag.Metrics;
    string[] months = ViewBag.Months;
    int[] raised = ViewBag.RaisedByMonth;
    int[] resolved = ViewBag.ResolvedByMonth;
    var kpiDefs = (List<VergerITDesk.Models.KpiDefinition>)ViewBag.KpiDefs;
}
<div class="topbar">
    <div><h1>Reports</h1><p>Trends and exports across all tickets and KPIs</p></div>
</div>
<div class="view">
    <div class="toolbar" style="justify-content:space-between;">
        <p class="hint" style="margin:0;">Fiscal-year view (Apr–Mar), built from all tickets and KPI records on file.</p>
        <a asp-action="ExportCsv" class="btn sm">⬇ Export tickets (CSV)</a>
    </div>

    <div class="grid kpi-cards" style="margin-top:16px;">
        <div class="card"><h3>Total tickets</h3><div class="big">@m.Total</div><div class="sub">@m.ResolvedCount resolved to date</div></div>
        <div class="card"><h3>SLA compliance</h3><div class="big">@(m.SlaRate.HasValue ? m.SlaRate.Value.ToString("P1") : "—")</div><div class="sub">IT.3.5 · target 90.0%</div></div>
        <div class="card"><h3>First-contact resolution</h3><div class="big">@(m.FcrRate.HasValue ? m.FcrRate.Value.ToString("P1") : "—")</div><div class="sub">IT.3.6 · target 75.0%</div></div>
        <div class="card"><h3>Avg. resolution time</h3><div class="big">@(m.AvgResolutionHours.HasValue ? (m.AvgResolutionHours < 48 ? $"{m.AvgResolutionHours:F0}h" : $"{m.AvgResolutionHours/24:F0}d") : "—")</div><div class="sub">Excludes time awaiting requester info</div></div>
        <div class="card"><h3>Business impact captured</h3><div class="big">$@m.TotalImpactUsd.ToString("N0")</div><div class="sub">@m.QuantifiedCount tickets quantified</div></div>
    </div>

    <div class="section-title"><h2>Ticket volume by month</h2><span>Raised vs. resolved</span></div>
    <div class="grid two-col">
        <div class="card">
            <h3>Raised</h3>
            <div class="barchart" style="margin-top:10px;">
                @{ var maxR = Math.Max(1, raised.DefaultIfEmpty(0).Max()); }
                @for (int i = 0; i < months.Length; i++)
                {
                    var pct = (int)Math.Round(100.0 * raised[i] / maxR);
                    <div class="bar-row"><div>@months[i]</div><div class="bar-track"><div class="bar-fill" style="width:@(pct)%;background:var(--blue-500);"></div></div><div class="val">@raised[i]</div></div>
                }
            </div>
        </div>
        <div class="card">
            <h3>Resolved</h3>
            <div class="barchart" style="margin-top:10px;">
                @{ var maxRes = Math.Max(1, resolved.DefaultIfEmpty(0).Max()); }
                @for (int i = 0; i < months.Length; i++)
                {
                    var pct = (int)Math.Round(100.0 * resolved[i] / maxRes);
                    <div class="bar-row"><div>@months[i]</div><div class="bar-track"><div class="bar-fill" style="width:@(pct)%;background:var(--green-500);"></div></div><div class="val">@resolved[i]</div></div>
                }
            </div>
        </div>
    </div>

    <div class="section-title"><h2>KPI trend</h2><span>Pick a KPI to see its month-by-month actuals</span></div>
    <div class="card">
        <table>
            <thead><tr><th>KPI</th><th>Owner</th><th>Target</th><th></th></tr></thead>
            <tbody>
            @foreach (var d in kpiDefs)
            {
                <tr>
                    <td>@d.Ref · @d.Name</td>
                    <td><span class="owner-chip">@d.Owner</span></td>
                    <td>@d.Target.ToString("P1")</td>
                    <td><a asp-controller="Kpi" asp-action="Trend" asp-route-kpiRef="@d.Ref" class="btn sm">View trend</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
