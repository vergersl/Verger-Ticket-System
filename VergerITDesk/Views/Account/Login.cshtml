@model LoginVm
@{ ViewData["Title"] = "Sign in"; }
<div class="view">
    <div class="card auth-card">
        <div style="text-align:center;margin-bottom:18px;">
            <img src="~/images/verger-emblem.png" alt="Verger" style="width:48px;" />
            <h2 style="margin:10px 0 2px;">Verger Naturals</h2>
            <p class="hint">IT Service Desk</p>
        </div>
        <div asp-validation-summary="All" class="validation-summary-errors"></div>
        <form asp-action="Login" method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="field">
                <label asp-for="Email">Email</label>
                <input asp-for="Email" autocomplete="username" />
                <span asp-validation-for="Email" class="field-validation-error"></span>
            </div>
            <div class="field">
                <label asp-for="Password">Password</label>
                <input asp-for="Password" type="password" autocomplete="current-password" />
                <span asp-validation-for="Password" class="field-validation-error"></span>
            </div>
            <div class="field" style="display:flex;align-items:center;gap:8px;">
                <input asp-for="RememberMe" type="checkbox" style="width:auto;" />
                <label asp-for="RememberMe" style="margin:0;">Remember me</label>
            </div>
            <button type="submit" class="btn primary" style="width:100%;">Sign in</button>
        </form>
        <p class="hint" style="text-align:center;margin-top:16px;">
            New here? <a asp-action="Register" style="color:var(--green-600);font-weight:600;">Create an account</a>
        </p>
    </div>
</div>
